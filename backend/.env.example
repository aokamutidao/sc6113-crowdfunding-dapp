# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
# Optional absolute path; default backend/db/database.sqlite
# DATABASE_PATH=/absolute/path/database.sqlite

# Blockchain Configuration
# RPC_URL takes priority over SEPOLIA_RPC_URL; local: http://127.0.0.1:8545
# RPC_URL=http://127.0.0.1:8545
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
FACTORY_CONTRACT_ADDRESS=0x... # Your deployed factory contract address
# Set the real factory deployment block on public networks to reduce log scanning.
FACTORY_DEPLOYMENT_BLOCK=0
# Optional comma-separated allowed origins; default permits all origins.
# CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info
