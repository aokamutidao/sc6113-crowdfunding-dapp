# Defaults target a local Hardhat chain. These values are public configuration;
# never store a private key in VITE_* variables (they are bundled into the UI).
VITE_FACTORY_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
VITE_RPC_URL=http://127.0.0.1:8545
VITE_API_URL=http://localhost:3000/api
VITE_CHAIN_ID=0x7a69
VITE_NETWORK_NAME=Hardhat Local
# Set this only when using a deployed network with a block explorer.
# VITE_BLOCK_EXPLORER=https://sepolia.etherscan.io
